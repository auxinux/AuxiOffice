                 "extensions": ["pdf", "djvu", "xps", "oxps"] },
    "text":    { "name": "AuxiText",    "kind_fr": "Éditeur de texte",    "kind_en": "Text editor",    "color": "#5F6B7A", "letter": "T",
                 "extensions": ["txt", "log", "md", "markdown", "json", "xml", "yaml", "yml", "ini", "conf", "cfg"] },
    "mail":    { "name": "AuxiMail",    "kind_fr": "Courriel (futur)",    "kind_en": "Mail (future)",  "color": "#3A8FB7", "letter": "M",
                 "extensions": [], "status": "study" }
