#pragma code_page(65001)
#include <windows.h>

// L'ordre des icônes fixe leur index pour les associations (DefaultIcon = auxioffice.exe,N)
1 ICON "@ICO@/auxioffice.ico"
2 ICON "@ICO@/mime-document.ico"
3 ICON "@ICO@/mime-spreadsheet.ico"
4 ICON "@ICO@/mime-presentation.ico"
5 ICON "@ICO@/mime-pdf.ico"
6 ICON "@ICO@/mime-text.ico"
7 ICON "@ICO@/auxiwriter.ico"
8 ICON "@ICO@/auxisheet.ico"
9 ICON "@ICO@/auxipresent.ico"
10 ICON "@ICO@/auxipdf.ico"
11 ICON "@ICO@/auxitext.ico"

1 VERSIONINFO
FILEVERSION     @V1@,@V2@,@V3@,@V4@
PRODUCTVERSION  @V1@,@V2@,@V3@,@V4@
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040C04B0"
        BEGIN
            VALUE "CompanyName",      "Projet AuxiNux"
            VALUE "FileDescription",  "AuxiNux Office"
            VALUE "FileVersion",      "@VERSION@"
            VALUE "InternalName",     "auxioffice"
            VALUE "LegalCopyright",   "© 2026 Projet AuxiNux — logiciel libre (AGPL-3.0)."
            VALUE "OriginalFilename", "auxioffice.exe"
            VALUE "ProductName",      "AuxiNux Office"
            VALUE "ProductVersion",   "@VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x040C, 1200
    END
END
