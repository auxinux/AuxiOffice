{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions des fenêtres d'AuxiText",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "core:menu:default",
    "core:window:allow-set-title",
    "core:window:allow-destroy",
    "core:window:allow-set-theme",
    "core:window:allow-close",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
