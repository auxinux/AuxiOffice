From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Projet AuxiNux <repo@auxinux.ca>
Date: Thu, 1 Oct 2026 20:25:29 +0000
Subject: [PATCH] shell: let Windows Settings handle default apps

When the user accepts the 'default application' prompt, open the Default Apps page of Windows Settings for AuxiNux Office (ms-settings:defaultapps?registeredAppMachine=...) instead of launching the helper that writes UserChoice entries. The user makes the choice in Windows, as recommended by Microsoft; nothing is forced.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 win-linux/src/platform_win/association.cpp | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/win-linux/src/platform_win/association.cpp b/win-linux/src/platform_win/association.cpp
index 403b081..503525c 100644
--- a/win-linux/src/platform_win/association.cpp
+++ b/win-linux/src/platform_win/association.cpp
@@ -32,6 +32,9 @@
  *
  * SPDX-License-Identifier: AGPL-3.0-only
  */
+/*
+ * Modified by Projet AuxiNux on 2026-10-01 for AuxiNux Office (see patches/desktop-apps/ in the AuxiNux Office repository).
+ */
 
 #include "association.h"
 #include "utils.h"
@@ -41,6 +44,7 @@
 #include <unordered_map>
 #include <unordered_set>
 #include <shlwapi.h>
+#include <QUrl>
 #include <ShlObj.h>
 #include <ctime>
 #ifdef __OS_WIN_XP
@@ -314,6 +318,15 @@ void Association::AssociationPrivate::associate(const std::vector<std::wstring>
     SHChangeNotify(SHCNE_ASSOCCHANGED, SHCNF_IDLIST, NULL, NULL);
 #else
     if (Utils::getWinVersion() > Utils::WinVer::Win7) {
+#ifdef AUXI_PRODUCT_NAME
+        // AuxiNux: the user picks the default apps in Windows Settings (page of this
+        // application, registered under HKLM\Software\RegisteredApplications by the
+        // installer); no UserChoice entry is written by the application.
+        std::wstring uri(L"ms-settings:defaultapps?registeredAppMachine=");
+        uri += QString::fromLatin1(QUrl::toPercentEncoding(QString::fromUtf8(APP_REG_NAME))).toStdWString();
+        ShellExecute(NULL, L"open", uri.c_str(), NULL, NULL, SW_SHOWNORMAL);
+        return;
+#endif
         std::wstring args(L"--assoc \"");
         for (const auto &ext : unassocFileExts) {
             auto it = m_extMap.find(ext);
