From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Projet AuxiNux <repo@auxinux.ca>
Date: Thu, 1 Oct 2026 17:51:40 +0000
Subject: [PATCH] shell: AuxiNux About information and legal notices

The About page receives the AuxiNux name/version and the attribution required by the upstream license additional terms (original developer, modification date, license files).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 win-linux/src/prop/cmainwindowimpl.cpp | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/win-linux/src/prop/cmainwindowimpl.cpp b/win-linux/src/prop/cmainwindowimpl.cpp
index 2e8a819..54b8f97 100644
--- a/win-linux/src/prop/cmainwindowimpl.cpp
+++ b/win-linux/src/prop/cmainwindowimpl.cpp
@@ -32,6 +32,9 @@
  *
  * SPDX-License-Identifier: AGPL-3.0-only
  */
+/*
+ * Modified by Projet AuxiNux on 2026-10-01 for AuxiNux Office (see patches/desktop-apps/ in the AuxiNux Office repository).
+ */
 
 #include "cmainwindowimpl.h"
 #include "cascapplicationmanagerwrapper.h"
@@ -39,6 +42,9 @@
 #include "utils.h"
 #include "version.h"
 #include "clangater.h"
+#ifdef AUXI_PRODUCT_NAME
+# include "auxinux/auxinux.h"
+#endif
 
 #include <QJsonObject>
 #include <QJsonDocument>
@@ -154,6 +160,9 @@ void CMainWindowImpl::refreshAboutVersion()
     if ( !_package.isEmpty() )
         _json_obj["pkg"] = _package;
 
+#ifdef AUXI_PRODUCT_NAME
+    AuxiNux::extendAboutInfo(_json_obj);
+#endif
     AscAppManager::sendCommandTo(SEND_TO_ALL_START_PAGE, "app:version", Utils::stringifyJson(_json_obj));
 
     _json_obj.empty();
