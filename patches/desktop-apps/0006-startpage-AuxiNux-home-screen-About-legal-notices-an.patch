 common/loginpage/src/panelabout.js     | 4 ++++
 common/loginpage/src/panelrecent.js    | 9 +++++++--
 common/loginpage/src/paneltemplates.js | 4 ++++
 4 files changed, 17 insertions(+), 2 deletions(-)

