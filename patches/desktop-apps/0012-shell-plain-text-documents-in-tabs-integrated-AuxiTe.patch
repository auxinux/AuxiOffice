From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Projet AuxiNux <repo@auxinux.ca>
Date: Fri, 2 Oct 2026 20:58:34 +0000
Subject: [PATCH] shell: plain text documents in tabs (integrated AuxiText)

Builds the AuxiNux components listed in src/auxinux/auxinux.pri (integrated AuxiText editor). Plain text files opened from the command line, a second instance or drag and drop go to AuxiText too, except with --writer ('Open in AuxiWriter', forwarded to the running instance). Text tabs are saved by the editor when the user chooses Save on close, and stay in the main window (no undocking).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 win-linux/defaults.pri                        |  1 +
 .../src/cascapplicationmanagerwrapper.cpp     | 13 ++++++++++++
 win-linux/src/main.cpp                        |  4 ++++
 win-linux/src/windows/cmainwindow.cpp         | 20 +++++++++++++++++++
 4 files changed, 38 insertions(+)

diff --git a/win-linux/defaults.pri b/win-linux/defaults.pri
index ce6232c..13a640a 100644
--- a/win-linux/defaults.pri
+++ b/win-linux/defaults.pri
@@ -165,6 +165,7 @@ exists($$PWD/src/auxinux/auxinux.cpp) {
     HEADERS += $$PWD/src/auxinux/auxinux.h
     SOURCES += $$PWD/src/auxinux/auxinux.cpp
 }
+exists($$PWD/src/auxinux/auxinux.pri): include($$PWD/src/auxinux/auxinux.pri)
 
 updmodule:!build_xp {
     HEADERS += $$PWD/src/cupdatemanager.h
diff --git a/win-linux/src/cascapplicationmanagerwrapper.cpp b/win-linux/src/cascapplicationmanagerwrapper.cpp
index 388ad99..c315aa7 100644
--- a/win-linux/src/cascapplicationmanagerwrapper.cpp
+++ b/win-linux/src/cascapplicationmanagerwrapper.cpp
@@ -60,6 +60,9 @@
 #include "common/Types.h"
 #include "common/File.h"
 #include "ctabundockevent.h"
+#ifdef AUXI_PRODUCT_NAME
+# include "auxinux/texttabs.h"
+#endif
 #include "clangater.h"
 #include "components/cmessage.h"
 #include "ceditortools.h"
@@ -1063,6 +1066,11 @@ void CAscApplicationManagerWrapper::handleInputCmd(const std::vector<wstring>& v
             } else
             if ( CFileInspector::isLocalFile(str_url) ) {
                 open_opts.srctype = etLocalFile;
+#ifdef AUXI_PRODUCT_NAME
+                // Fichier texte : AuxiText (onglet ou application), sauf « Ouvrir dans AuxiWriter » (--writer)
+                if ( std::find(vargs.begin(), vargs.end(), L"--writer") == vargs.end() && AuxiNux::openIfTextFile(str_url) )
+                    continue;
+#endif
 #ifdef Q_OS_WIN
                 int _error = _waccess(open_opts.wurl.c_str(), 0);
                 auto _c_pos = open_opts.wurl.rfind(L"\\");
@@ -1914,6 +1922,11 @@ bool CAscApplicationManagerWrapper::event(QEvent *event)
             if ( !(e->index() < 0) ) {
                 _editor = static_cast<CTabPanel *>(_main_window->editor(e->index()));
             }
+#ifdef AUXI_PRODUCT_NAME
+            // Fichier texte (AuxiText intégré) : reste dans la fenêtre principale.
+            if ( _editor && AuxiNux::isTextTab(_editor) )
+                _editor = nullptr;
+#endif
 
             if ( _editor ) {
 //                _editor->setParent(nullptr);
diff --git a/win-linux/src/main.cpp b/win-linux/src/main.cpp
index a9013af..a371c02 100644
--- a/win-linux/src/main.cpp
+++ b/win-linux/src/main.cpp
@@ -170,7 +170,11 @@ int main( int argc, char *argv[] )
         if (_args.size() > 0) {
             foreach (auto w_arg, _args) {
                 const QString arg = QString::fromStdWString(w_arg);
+#ifdef AUXI_PRODUCT_NAME
+                if ( arg.startsWith("--new:") || arg == "--writer" )
+#else
                 if ( arg.startsWith("--new:") )
+#endif
                     _out_args.append(arg).append(";");
                 else
                 if ( arg.mid(0,2) != "--" )
diff --git a/win-linux/src/windows/cmainwindow.cpp b/win-linux/src/windows/cmainwindow.cpp
index e74d9dc..5167fdb 100644
--- a/win-linux/src/windows/cmainwindow.cpp
+++ b/win-linux/src/windows/cmainwindow.cpp
@@ -48,6 +48,10 @@
 #include "version.h"
 #include "components/cmessage.h"
 #include "ctabundockevent.h"
+#ifdef AUXI_PRODUCT_NAME
+# include "auxinux/auxinux.h"
+# include "auxinux/texttabs.h"
+#endif
 #include <qtcomp/qdesktopwidget.h>
 #include <QGridLayout>
 #include <QTimer>
@@ -734,6 +738,14 @@ int CMainWindow::trySaveDocument(int index)
         case MODAL_RESULT_CANCEL: modal_res = MODAL_RESULT_CANCEL; break;
         case MODAL_RESULT_YES:
         default:{
+#ifdef AUXI_PRODUCT_NAME
+            // Fichier texte (AuxiText intégré) : enregistré par l'éditeur, puis fermé comme
+            // après « Ne pas enregistrer » ; échec ou annulation : l'onglet reste ouvert.
+            if ( const int text = AuxiNux::saveTextTab(m_pTabs->panel(index)) ) {
+                modal_res = text > 0 ? MODAL_RESULT_NO : MODAL_RESULT_CANCEL;
+                break;
+            }
+#endif
             m_pTabs->editorCloseRequest(index);
             m_pTabs->panel(index)->cef()->Apply(new CAscMenuEvent(ASC_MENU_EVENT_TYPE_CEF_SAVE));
             Utils::processMoreEvents();
@@ -808,7 +820,11 @@ void CMainWindow::setTabMenu(int index, const QPoint &pos)
                 m_pTabs->tabBar()->moveTab(index, destIndex);
         }, Qt::QueuedConnection);
 
+#ifdef AUXI_PRODUCT_NAME
+    if (panel && panel->data()->isViewType(cvwtEditor) && !AuxiNux::isTextTab(panel)) {
+#else
     if (panel && panel->data()->isViewType(cvwtEditor)) {
+#endif
         QAction *actUnpinTab = menu->addSection(CMenu::ActionUnpinTab);
         // actUnpinTab->setIcon(IconFactory::icon(IconFactory::Unpin, SMALL_ICON * m_dpiRatio));
         connect(actUnpinTab, &QAction::triggered, this, [=]() {
@@ -949,6 +965,10 @@ void CMainWindow::onPortalUITheme(int viewid, const std::wstring& json)
 
 void CMainWindow::doOpenLocalFile(COpenOptions& opts)
 {
+#ifdef AUXI_PRODUCT_NAME
+    if ( AuxiNux::openIfTextFile(opts.url) )
+        return;     // fichier texte (glisser-déposer…) : AuxiText
+#endif
     QFileInfo info(opts.url);
     if (!info.exists()) { return; }
     if (!info.isFile()) { return; }
