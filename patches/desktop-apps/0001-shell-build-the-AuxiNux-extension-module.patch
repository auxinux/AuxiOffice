From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Projet AuxiNux <repo@auxinux.ca>
Date: Thu, 1 Oct 2026 17:51:40 +0000
Subject: [PATCH] shell: build the AuxiNux extension module

Adds src/auxinux/auxinux.{h,cpp} (copied from the AuxiNux Office repository at build time) to the qmake project when present.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 win-linux/defaults.pri | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/win-linux/defaults.pri b/win-linux/defaults.pri
index 6516d2b..ce6232c 100644
--- a/win-linux/defaults.pri
+++ b/win-linux/defaults.pri
@@ -1,3 +1,4 @@
+# Modified by Projet AuxiNux on 2026-10-01 for AuxiNux Office (see patches/desktop-apps/).
 
 QT  += core gui widgets printsupport
 QT  += svg
@@ -159,6 +160,12 @@ SOURCES += \
     $$PWD/src/iconfactory.cpp \
     $$PWD/src/cthemes.cpp
 
+# AuxiNux Office: shell extensions (copied from the AuxiNux repository during the build)
+exists($$PWD/src/auxinux/auxinux.cpp) {
+    HEADERS += $$PWD/src/auxinux/auxinux.h
+    SOURCES += $$PWD/src/auxinux/auxinux.cpp
+}
+
 updmodule:!build_xp {
     HEADERS += $$PWD/src/cupdatemanager.h
     SOURCES += $$PWD/src/cupdatemanager.cpp
