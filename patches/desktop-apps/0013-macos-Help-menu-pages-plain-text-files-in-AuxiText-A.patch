+#ifdef _AUXINUX
+// AuxiNux Office : fichiers texte brut ouverts dans AuxiText (Contents/Applications/AuxiText.app)
+// au lieu d'AuxiWriter. Extensions : privacy de branding/product.json (apps.text, sans CSV).
+static NSArray<NSString *> * auxinuxTextExtensions() {
+    return @[@"txt", @"log", @"md", @"markdown", @"json", @"xml", @"yaml", @"yml", @"ini", @"conf", @"cfg"];
+}
+
+// « Ouvrir dans AuxiWriter » d'AuxiText laisse /tmp/auxinux-writer/<FNV-1a du chemin> (heure Unix) :
+// le fichier reste alors dans AuxiWriter (même calcul que App::writerMarkName d'AuxiText).
+static BOOL auxinuxWriterRequested(NSString * path) {
+    const char * bytes = [path UTF8String];
+    uint32_t h = 0x811c9dc5u;
+    for (const char * c = bytes; c && *c; ++c) {
+        h ^= (uint8_t)*c;
+        h *= 0x01000193u;
+    }
+    NSString * mark = [NSString stringWithFormat:@"/tmp/auxinux-writer/%08x", h];
+    NSString * stamp = [NSString stringWithContentsOfFile:mark encoding:NSUTF8StringEncoding error:nil];
+    return stamp && fabs([[NSDate date] timeIntervalSince1970] - [stamp doubleValue]) < 300;
+}
+
+static BOOL auxinuxOpenInTextEditor(NSString * path) {
+    if (!path || ![auxinuxTextExtensions() containsObject:path.pathExtension.lowercaseString] || auxinuxWriterRequested(path))
+        return NO;
+    NSURL * editor = [[[NSBundle mainBundle] bundleURL] URLByAppendingPathComponent:@"Contents/Applications/AuxiText.app"];
+    if (![[NSFileManager defaultManager] fileExistsAtPath:editor.path])
+        return NO;
+    [[NSWorkspace sharedWorkspace] openURLs:@[[NSURL fileURLWithPath:path]]
+                       withApplicationAtURL:editor
+                              configuration:[NSWorkspaceOpenConfiguration configuration]
+                          completionHandler:nil];
+    return YES;
+}
+#endif
+
