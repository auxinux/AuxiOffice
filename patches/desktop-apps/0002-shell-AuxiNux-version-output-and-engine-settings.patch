From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Projet AuxiNux <repo@auxinux.ca>
Date: Thu, 1 Oct 2026 17:51:40 +0000
Subject: [PATCH] shell: AuxiNux version output and engine settings

--version prints 'AuxiNux Office <version>' on stdout; after setup_paths() the CEF cache moves to the XDG cache directory and the converter writes the AuxiNux application name into document metadata.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 win-linux/src/main.cpp | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/win-linux/src/main.cpp b/win-linux/src/main.cpp
index 9e8fd7c..fb07258 100644
--- a/win-linux/src/main.cpp
+++ b/win-linux/src/main.cpp
@@ -32,6 +32,9 @@
  *
  * SPDX-License-Identifier: AGPL-3.0-only
  */
+/*
+ * Modified by Projet AuxiNux on 2026-10-01 for AuxiNux Office (see patches/desktop-apps/ in the AuxiNux Office repository).
+ */
 
 #ifdef _WIN32
 # include "platform_win/singleapplication.h"
@@ -48,6 +51,9 @@
 #include "version.h"
 #include "utils.h"
 #include "chelp.h"
+#ifdef AUXI_PRODUCT_NAME
+# include "auxinux/auxinux.h"
+#endif
 #include "common/File.h"
 #include <QStyleFactory>
 
@@ -114,10 +120,17 @@ int main( int argc, char *argv[] )
         manager->m_oSettings.additional_fonts_folder.push_back(app_path + L"/fonts");
         manager->m_oSettings.country = Utils::systemLocationCode().toStdString();
         manager->m_oSettings.connection_error_path      = app_path + L"/editors/webext/noconnect.html";
+#ifdef AUXI_PRODUCT_NAME
+        AuxiNux::adjustSettings(manager->m_oSettings);
+#endif
     };
 
     if ( InputArgs::contains(L"--version") ) {
+#ifdef AUXI_PRODUCT_NAME
+        AuxiNux::printVersion();
+#else
         qWarning() << VER_PRODUCTNAME_STR << "ver." << VER_FILEVERSION_STR;
+#endif
         return 0;
     } else
     if ( InputArgs::contains(L"--help") ) {
