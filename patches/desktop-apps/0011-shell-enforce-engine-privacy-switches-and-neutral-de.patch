From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Projet AuxiNux <repo@auxinux.ca>
Date: Fri, 2 Oct 2026 20:39:06 +0000
Subject: [PATCH] shell: enforce engine privacy switches and neutral default
 author name

The shell relaunches itself with the Chromium privacy switches when started without them (binary started directly, pinned taskbar shortcut, caller's --disable-features). The default author name written into documents is a neutral name instead of the system account name.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 win-linux/src/main.cpp  |  4 ++++
 win-linux/src/utils.cpp | 11 +++++++++++
 2 files changed, 15 insertions(+)

diff --git a/win-linux/src/main.cpp b/win-linux/src/main.cpp
index 4690ec4..a9013af 100644
--- a/win-linux/src/main.cpp
+++ b/win-linux/src/main.cpp
@@ -60,6 +60,10 @@
 
 int main( int argc, char *argv[] )
 {
+#ifdef AUXI_PRODUCT_NAME
+    if ( AuxiNux::relaunchWithEngineSwitches(argc, argv) )
+        return 0;
+#endif
 #ifdef _WIN32
     Core_SetProcessDpiAwareness();
     Utils::setAppUserModelId();
diff --git a/win-linux/src/utils.cpp b/win-linux/src/utils.cpp
index 2e8fff9..6977c4d 100644
--- a/win-linux/src/utils.cpp
+++ b/win-linux/src/utils.cpp
@@ -32,12 +32,18 @@
  *
  * SPDX-License-Identifier: AGPL-3.0-only
  */
+/*
+ * Modified by Projet AuxiNux on 2026-10-02 for AuxiNux Office (see patches/desktop-apps/ in the AuxiNux Office repository).
+ */
 
 #ifdef __linux__
 # include "platform_linux/gtkutils.h"
 #endif
 #include "utils.h"
 #include "defines.h"
+#ifdef AUXI_PRODUCT_NAME
+# include "auxinux/auxinux.h"
+#endif
 #include <QSettings>
 #include <QStandardPaths>
 #include <QDir>
@@ -888,6 +894,11 @@ void Utils::replaceAll(std::wstring& subject, const std::wstring& search, const
 
 std::wstring Utils::systemUserName()
 {
+#ifdef AUXI_PRODUCT_NAME
+    // Nom d'auteur neutre : le nom réel du compte (Windows) ou l'identifiant de connexion
+    // ne sont pas écrits dans les documents tant que l'utilisateur n'a pas choisi un nom.
+    return AuxiNux::defaultUserName();
+#endif
 #ifdef Q_OS_WIN
     WCHAR _env_name[UNLEN + 1]{0};
     DWORD _size = UNLEN + 1;
