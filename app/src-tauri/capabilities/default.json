{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions des fenêtres d'AuxiOffice (principale et fenêtres de documents)",
  "windows": ["main", "w*"],
  "permissions": [
    "core:default",
    "core:menu:default",
    "core:window:allow-set-title",
    "core:window:allow-destroy",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask"
  ]
}
