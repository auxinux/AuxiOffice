<?xml version="1.0" encoding="utf-8"?>
<!--
  AuxiNux Office — paquet MSI (WiX 3, compilé avec wixl de msitools)
  SPDX-License-Identifier: AGPL-3.0-or-later
  Copyright (C) 2026 Projet AuxiNux

  Modèle complété par scripts/auxibuild/package_windows.py (variables @…@ : identité, version,
  arborescence des fichiers, types de fichiers).

  Propriétés publiques (msiexec /i AuxiNuxOffice-<version>-x64.msi /qn PROPRIÉTÉ=valeur) :
    INSTALLDIR=<dossier>   dossier d'installation (défaut : %ProgramFiles%\AuxiNux Office)
    NODESKTOP=1            pas de raccourci sur le Bureau
    NOASSOC=1              ne pas proposer AuxiNux Office pour les types de fichiers
    APPLOCALE=en-US        langue par défaut d'AuxiNux Office (défaut : fr-FR)

  Contrairement à l'installateur .exe, le MSI n'installe pas le redistribuable Microsoft
  Visual C++ : il doit être déployé avant (vc_redist.x64.exe /install /quiet /norestart) ;
  sinon l'installation s'arrête avec un message explicite.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="@PRODUCT_NAME@" Language="1036" Codepage="1252" Version="@VERSION4@"
           Manufacturer="@PUBLISHER@" UpgradeCode="@UPGRADE_CODE@">
    <Package Description="@PRODUCT_NAME@ @VERSION@" Comments="Suite bureautique libre"
             Manufacturer="@PUBLISHER@" InstallerVersion="500" Languages="1036" Compressed="yes"
             SummaryCodepage="1252" InstallScope="perMachine"/>

    <MajorUpgrade DowngradeErrorMessage="Une version plus récente de @PRODUCT_NAME@ est déjà installée."/>
    <Media Id="1" Cabinet="auxioffice.cab" EmbedCab="yes"/>

@ICONS@
    <Property Id="ARPPRODUCTICON" Value="auxioffice.ico"/>
    <Property Id="ARPURLINFOABOUT" Value="@WEBSITE@"/>
    <Property Id="ARPHELPLINK" Value="@SUPPORT_URL@"/>
    <Property Id="ARPCOMMENTS" Value="Suite bureautique libre : traitement de texte, tableur, présentations, PDF et texte brut."/>
    <Property Id="ARPNOMODIFY" Value="1"/>
    <Property Id="ARPNOREPAIR" Value="1"/>
    <Property Id="APPLOCALE" Value="fr-FR"/>

    <Property Id="VCRUNTIMEVERSION">
      <RegistrySearch Id="VCRuntimeVersion" Root="HKLM" Key="SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x64"
                      Name="Version" Type="raw" Win64="yes"/>
    </Property>
    <Condition Message="@PRODUCT_NAME@ nécessite Microsoft Visual C++ Redistributable 2015-2022 x64 (@VC_REDIST_VERSION@ ou plus récent). Installez-le d'abord (vc_redist.x64.exe /install /quiet /norestart) ou utilisez l'installateur AuxiNuxOffice-@VERSION@-x64.exe, qui l'inclut. / @PRODUCT_NAME@ requires Microsoft Visual C++ Redistributable 2015-2022 x64 (@VC_REDIST_VERSION@ or later).">Installed OR (VCRUNTIMEVERSION &gt;= "v@VC_MIN@")</Condition>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="@INSTALL_DIR_NAME@">
@FILES@
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="AppMenuFolder" Name="@PRODUCT_NAME@"/>
      </Directory>
      <Directory Id="DesktopFolder"/>
    </Directory>

    <DirectoryRef Id="AppMenuFolder">
      <Component Id="StartMenu" Guid="@GUID_SHORTCUTS@" Win64="yes">
        <Shortcut Id="sc_main" Name="@PRODUCT_NAME@" Description="Suite bureautique libre"
                  Target="[INSTALLDIR]auxioffice.exe" WorkingDirectory="INSTALLDIR" Icon="auxioffice.ico"/>
@SHORTCUTS@
        <RemoveFolder Id="RemoveAppMenuFolder" On="uninstall"/>
        <RegistryValue Root="HKLM" Key="@REG_APP_PATH@" Name="StartMenuShortcuts" Type="integer" Value="1" KeyPath="yes"/>
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="@GUID_DESKTOP@" Win64="yes">
        <Shortcut Id="sc_desktop" Name="@PRODUCT_NAME@" Description="Suite bureautique libre"
                  Target="[INSTALLDIR]auxioffice.exe" WorkingDirectory="INSTALLDIR" Icon="auxioffice.ico"/>
        <RegistryValue Root="HKLM" Key="@REG_APP_PATH@" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes"/>
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="INSTALLDIR">
      <Component Id="AppRegistry" Guid="@GUID_REGISTRY@" Win64="yes">
        <RegistryValue Root="HKLM" Key="@REG_APP_PATH@" Name="AppPath" Type="string" Value="[INSTALLDIR]" KeyPath="yes"/>
        <RegistryValue Root="HKLM" Key="@REG_APP_PATH@" Name="Version" Type="string" Value="@VERSION@"/>
        <RegistryValue Root="HKLM" Key="@REG_APP_PATH@" Name="PackageType" Type="string" Value="msi"/>
        <RegistryValue Root="HKLM" Key="@REG_APP_PATH@" Name="locale" Type="string" Value="[APPLOCALE]"/>
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\auxioffice.exe" Type="string" Value="[INSTALLDIR]auxioffice.exe"/>
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\auxioffice.exe" Name="Path" Type="string" Value="[INSTALLDIR]"/>
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\auxitext.exe" Type="string" Value="[INSTALLDIR]auxitext.exe"/>
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\auxitext.exe" Name="Path" Type="string" Value="[INSTALLDIR]"/>
      </Component>
      <!-- Déclaration seulement (ProgID, « Ouvrir avec », Applications par défaut) : aucun choix
           par défaut n'est modifié ; l'utilisateur choisit dans Windows. -->
      <Component Id="Associations" Guid="@GUID_ASSOC@" Win64="yes">
        <RegistryValue Root="HKLM" Key="@REG_APP_PATH@\Capabilities" Name="ApplicationName" Type="string" Value="@PRODUCT_NAME@" KeyPath="yes"/>
        <RegistryValue Root="HKLM" Key="@REG_APP_PATH@\Capabilities" Name="ApplicationDescription" Type="string" Value="Suite bureautique libre"/>
        <RegistryValue Root="HKLM" Key="@REG_APP_PATH@\Capabilities" Name="ApplicationIcon" Type="string" Value="[INSTALLDIR]auxioffice.exe,0"/>
        <RegistryValue Root="HKLM" Key="Software\RegisteredApplications" Name="@PRODUCT_NAME@" Type="string" Value="@REG_APP_PATH@\Capabilities"/>
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\auxioffice.exe" Name="FriendlyAppName" Type="string" Value="@PRODUCT_NAME@"/>
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\auxitext.exe" Name="FriendlyAppName" Type="string" Value="@TEXT_APP_NAME@"/>
@ASSOC_REGISTRY@
      </Component>
    </DirectoryRef>

    <Feature Id="Main" Title="@PRODUCT_NAME@" Level="1" Absent="disallow">
      <ComponentRef Id="AppRegistry"/>
      <ComponentRef Id="StartMenu"/>
@FILE_REFS@
    </Feature>
    <Feature Id="FileTypes" Title="Types de fichiers" Level="1">
      <ComponentRef Id="Associations"/>
      <Condition Level="0">NOASSOC = "1"</Condition>
    </Feature>
    <Feature Id="Desktop" Title="Raccourci sur le Bureau" Level="1">
      <ComponentRef Id="DesktopShortcut"/>
      <Condition Level="0">NODESKTOP = "1"</Condition>
    </Feature>
  </Product>
</Wix>
